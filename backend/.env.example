# ============================================================
# VEICULOTRACKER API - Variáveis de ambiente
# Copie este arquivo para .env e ajuste conforme necessário
# ============================================================

# Porta HTTP da API (app e hardware falam com ela)
PORT=3000

# Caminho do arquivo SQLite
DB_PATH=./data/veiculotracker.db

# Segredo usado para assinar tokens do app (troque em produção)
JWT_SECRET=troque-este-segredo-no-prod

# Quantidade máxima de pontos de telemetria mantidos por veículo
MAX_TELEMETRY_POINTS=10000

# Intervalo (ms) que o simulador de hardware envia telemetria
SIMULATOR_INTERVAL_MS=5000

# Coordenadas de partida do simulador (ex.: centro de São Paulo)
SIMULATOR_START_LAT=-23.5505
SIMULATOR_START_LNG=-46.6333

# Habilitar log de requisições no console
LOG_REQUESTS=true

# ============================================================
# SINCronização SQLite -> Firebase (Firestore + Realtime DB)
# Habilita a sincronização automática em intervalo determinado
# ============================================================
# Liga/desliga a sincronização automática
FIREBASE_SYNC_ENABLED=false

# Intervalo de sincronização em milissegundos (padrão: 60000 = 60s)
FIREBASE_SYNC_INTERVAL_MS=60000

# Caminho para o JSON de credenciais da conta de serviço Firebase
# (Firebase Console > Configurações do projeto > Contas de serviço >
#  Gerar nova chave privada). O arquivo NÃO deve ser versionado.
FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json

# URL do Realtime Database usado pelo app Android (campo host)
# Ex.: https://securitas-ce0bd-default-rtdb.firebaseio.com
FIREBASE_DATABASE_URL=https://SEU-PROJETO-default-rtdb.firebaseio.com

# Nome do projeto Firebase usado no app (Firestore instance id).
# No app Android a instância é criada com FirebaseFirestore.getInstance("securitas")
FIRESTORE_ID=securitas