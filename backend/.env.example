# ============================================================
# SECURITAS API - Variáveis de ambiente
# Copie este arquivo para .env e ajuste conforme necessário
# ============================================================
# O banco da API é o Firebase (Firestore + Realtime Database).
# Não há mais SQLite nesta pasta (o antigo data/securitas.db é legado).

# Porta HTTP da API (app e hardware falam com ela)
PORT=3000

# Intervalo (ms) que o simulador de hardware envia telemetria
SIMULATOR_INTERVAL_MS=5000

# Coordenadas de partida do simulador (ex.: centro de São Paulo)
SIMULATOR_START_LAT=-23.5505
SIMULATOR_START_LNG=-46.6333

# ============================================================
# SIMULAÇÃO DE VEÍCULOS
# Quando um veículo entra na simulação, a API cria um "rastreador virtual"
# (device com model='server-sim') e o simulador de hardware o movimenta.
# ============================================================
# Liga/desliga a criação de rastreadores virtuais pela API
SIMULATION_ENABLED=true

# Habilitar log de requisições no console (além do buffer do painel web)
LOG_REQUESTS=true

# ============================================================
# FIREBASE (obrigatório)
# ============================================================
# Caminho para o JSON de credenciais da conta de serviço Firebase
# (Firebase Console > Configurações do projeto > Contas de serviço >
#  Gerar nova chave privada). O arquivo NÃO deve ser versionado.
FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json

# URL do Realtime Database usado pelo app Android e pela API (telemetria ao
# vivo, comandos e última localização do celular). É OBRIGATÓRIA: sem ela o
# SDK Admin falha ao inicializar.
FIREBASE_DATABASE_URL=https://securitas-ce0bd-default-rtdb.firebaseio.com

# Nome do projeto Firebase usado no app (Firestore instance id).
# No app Android a instância é criada com FirebaseFirestore.getInstance("securitas")
FIRESTORE_ID=securitas

# apiKey pública do Firebase (Web API key), usada pelo PAINEL WEB para o login
# via REST do Identity Toolkit. Não é segredo (vai embutida no cliente). Se
# omitida, a API lê automaticamente de app/google-services.json.
FIREBASE_API_KEY=
