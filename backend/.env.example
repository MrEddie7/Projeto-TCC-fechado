# ============================================================
# VEICULOTRACKER API - Variáveis de ambiente
# Copie este arquivo para .env e ajuste conforme necessário
# ============================================================

# Porta HTTP da API (app e hardware falam com ela)
PORT=3000

# Caminho do arquivo SQLite
DB_PATH=./data/veiculotracker.db

# Segredo usado para assinar tokens do app (troque em produção)
JWT_SECRET=troque-este-segredo-no-prod

# Quantidade máxima de pontos de telemetria mantidos por veículo
MAX_TELEMETRY_POINTS=10000

# Intervalo (ms) que o simulador de hardware envia telemetria
SIMULATOR_INTERVAL_MS=5000

# Coordenadas de partida do simulador (ex.: centro de São Paulo)
SIMULATOR_START_LAT=-23.5505
SIMULATOR_START_LNG=-46.6333

# Habilitar log de requisições no console
LOG_REQUESTS=true