        android:fillColor="#FFFFFF"
        android:pathData="M12,2a10,10 0 1,0 0.0001,0z" />
    <!-- círculo azul -->
    <path
        android:fillColor="#2979FF"
        android:pathData="M12,3.6a8.4,8.4 0 1,0 0,16.8a8.4,8.4 0 1,0 0,-16.8z" />
